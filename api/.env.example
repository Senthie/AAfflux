# Application
APP_NAME="Low-Code Platform Backend"
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Security
JWT_SECRET_KEY=your-secret-key-min-32-characters-long-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database - PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@14.12.0.102:5432/lowcode_platform
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# MongoDB
MONGODB_URL=mongodb://14.12.0.102:27017
MONGODB_DATABASE=lowcode_platform

# Redis
REDIS_URL=redis://14.12.0.102:6379
REDIS_DB=0
REDIS_MAX_CONNECTIONS=10

# Celery (optional, defaults to Redis URL)
# CELERY_BROKER_URL=redis://14.12.0.102:6379/0
# CELERY_RESULT_BACKEND=redis://14.12.0.102:6379/0

# Sentry (optional)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# File Upload
MAX_UPLOAD_SIZE=104857600  # 100MB in bytes
GRIDFS_THRESHOLD=16777216  # 16MB in bytes

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
CORS_ALLOW_CREDENTIALS=true
# Application
APP_NAME=Low-Code Platform Backend
DEBUG=false
HOST=0.0.0.0
PORT=8000
SECRET_KEY=your-super-secret-key-at-least-32-characters-long

# Security
JWT_SECRET_KEY=your-super-secret-jwt-key-at-least-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database - PostgreSQL
DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/lowcode_platform
POSTGRES_DB=lowcode_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=lowcode_platform
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=admin123
MONGO_DATABASE=lowcode_files
MONGO_PORT=27017

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=redis123
REDIS_HOST=localhost
REDIS_PORT=6379

# Sentry (Optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# SMTP邮件配置 - 支持多种邮箱服务商
# 企业微信邮箱 (推荐)
SMTP_HOST=smtp.exmail.qq.com
SMTP_PORT=465
# Gmail
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# 163邮箱
# SMTP_HOST=smtp.163.com
# SMTP_PORT=587

SMTP_USERNAME=your-email@yourcompany.com
SMTP_PASSWORD=your-email-password
FROM_EMAIL=noreply@yourcompany.com
FRONTEND_URL=https://yourapp.com

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["GET","POST","PUT","DELETE","OPTIONS"]
CORS_ALLOW_HEADERS=["*"]

# API配置
API_V1_PREFIX=/api/v1
API_PORT=8000

# Celery配置
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# 文件上传配置
MAX_FILE_SIZE=10485760  # 10MB
ALLOWED_FILE_TYPES=["image/jpeg","image/png","image/gif","application/pdf","text/plain"]

# 缓存配置
CACHE_TTL=3600  # 1小时
CACHE_PREFIX=lowcode

# 日志配置
LOG_LEVEL=INFO
LOG_FORMAT=json

# Docker配置
NGINX_PORT=80
NGINX_SSL_PORT=443