{
  "enabled": true,
  "name": "ruff检测",
  "description": "",
  "version": "1",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "askAgent",
    "prompt": "运行\"ruff check --fix .\"并修复出现的问题。最后执行 \"ruff format\"格式化整个项目的代码结构"
  },
  "workspaceFolderName": "api",
  "shortName": "ruff_check"
}